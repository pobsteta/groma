{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "initial-version": "0.1.0",
  "pull-request-title-pattern": "chore: publier la version ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Nouveautés" },
    { "type": "fix", "section": "Corrections" },
    { "type": "perf", "section": "Performances" },
    { "type": "revert", "section": "Retours en arrière" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Remaniements", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Construction", "hidden": true },
    { "type": "ci", "section": "Intégration continue", "hidden": true },
    { "type": "chore", "section": "Divers", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "groma",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "core/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "server/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "generic", "path": "core/src/groma/__init__.py" },
        { "type": "generic", "path": "server/src/groma_server/__init__.py" },
        { "type": "generic", "path": "android/app/build.gradle.kts" }
      ]
    }
  }
}
